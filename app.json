{
  "expo": {
    "name": "Cat Translator",
    "slug": "cat-translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cattranslator",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.codebp.cattranslator",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cat Translator uses the microphone to record meows and your voice so they can be translated."
      }
    },
    "android": {
      "package": "com.codebp.cattranslator",
      "adaptiveIcon": {
        "backgroundColor": "#E4EEFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4D7DF2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cat Translator uses the microphone to record meows and your voice so they can be translated."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
